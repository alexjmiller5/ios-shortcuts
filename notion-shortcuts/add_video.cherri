#define color darkgray
#define glyph iPhone

@URL = getClipboard()

// Define the data as a native Dictionary object
const JSONBody = {
    "parent": {
        "database_id": "***REMOVED***"
    },
    "properties": {
        "Title": {
            "title": [
                {
                    "text": {
                        "content": "Ask for Input"
                    }
                }
            ]
        },
        "URL": {
            "url": "URL"
        }
    },
    "icon": {
        "type": "emoji",
        "emoji": "📱"
    }
}

const URL = url("https://api.notion.com/v1/pages")

const API_Response = jsonRequest(URL, "POST", {
    "parent": {
        "database_id": "***REMOVED***"
    },
    "properties": {
        "Title": {
            "title": [
                {
                    "text": {
                        "content": "New Link from Clipboard"
                    }
                }
            ]
        },
        "URL": {
            "url": "PastedURL"
        }
    },
    "icon": {
        "type": "emoji",
        "emoji": "📱"
    }
}, {
    "Authorization": "Bearer ***REMOVED***",
    "Content-Type": "application/json",
    "Notion-Version": "2022-06-28"
})
