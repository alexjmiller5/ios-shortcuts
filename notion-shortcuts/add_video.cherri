#define name Add Video
#define color darkgray
#define glyph iPhone

@Title = prompt("Enter the title for the video")

const API_Response = jsonRequest("https://api.notion.com/v1/pages", "POST", {
    "parent": {
        "database_id": "NOTION_VIDEO_DATABASE_ID"
    },
    "properties": {
        "Title": {
            "title": [
                {
                    "text": {
                        "content": "{Title}"
                    }
                }
            ]
        },
        "URL": {
            "url": "{Clipboard}"
        }
    },
    "icon": {
        "type": "emoji",
        "emoji": "📱"
    }
}, {
    "Authorization": "Bearer NOTION_INTEGRATION_SECRET",
    "Content-Type": "application/json",
    "Notion-Version": "2022-06-28"
})
