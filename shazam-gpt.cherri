/*
 * Shazam to Spotify
 *
 * This shortcut recognizes a song using Shazam, finds it on Spotify,
 * and adds it to a specified playlist.
 *
 * This is a corrected and debugged version of the original code.
 */

// --- Shortcut Metadata ---
// Corrected the name to remove the invalid '→' character.
#define name "Shazam to Spotify"
// #define glyph "music.note" // Using a standard SFSymbol
#define color blue

// --- Configuration ---
// This constant acts as a switch.
// Set to "Hardcoded" to use the credentials below.
// Set to anything else to load from "credentials.json" in your Shortcuts folder.
const USE_HARDCODED_CREDS = "Hardcoded"

// --- 1. Recognize Song ---
// This logic is clearer than a single-iteration repeat loop.
// If the 'Song' variable was not passed into this shortcut, run Shazam.
if !Song {
    // rawAction calls the Shazam intent directly.
    // The result is a 'Shazam Media' object, which we store in a variable.
    @ShazamResult = rawAction("com.apple.musicrecognition.RecognizeMusicIntent")

    // We must check if Shazam returned a result before trying to access it.
    if ShazamResult {
        // CORRECTED: Extract details from the ShazamResult object.
        // You can't just access ['Title']; you need to use the 'Get Details' action.
        @Song = Get Details of Shazam Media(ShazamResult, "Title")
        @Artist = Get Details of Shazam Media(ShazamResult, "Artist")
    }
}

// If after trying, we still have no song, show an error and exit.
if !Song {
    ShowResult("Unable to recognize the song. Please try again when music is playing clearly.")
    stop()
}


// --- 2. Load Spotify Credentials ---
if USE_HARDCODED_CREDS != "Hardcoded" {
    // Load credentials from a file in the iCloud/Shortcuts/ directory.
    const File = getFile("credentials.json", errorIfNotFound: false)
    if !File {
        // CORRECTED: The error message should only show if the file is not found.
        ShowResult("Unable to access credentials.json file. Please ensure it exists in your Shortcuts folder.")
        stop()
    }
    // If the file exists, get the values.
    @ClientID = File['client_id']
    @ClientSecret = File['client_secret']
    @RefreshToken = File['refresh_token']
    @PlaylistID = File['playlist_id']

} else {
    // Using hardcoded credentials.
    // NOTE: Storing refresh tokens and secrets directly in code is not recommended
    // for shared shortcuts, but is acceptable for personal use.
    const Credentials = {
        "ClientID": "SPOTIFY_CLIENT_ID",
        "ClientSecret": "SPOTIFY_CLIENT_SECRET",
        "PlaylistID": "SPOTIFY_SHAZAM_PLAYLIST_ID",
        "RefreshToken": "SPOTIFY_REFRESH_TOKEN"
    }
    @ClientID = Credentials['ClientID']
    @ClientSecret = Credentials['ClientSecret']
    @RefreshToken = Credentials['RefreshToken']
    @PlaylistID = Credentials['PlaylistID']
}


// --- 3. Authenticate with Spotify ---
// Get a new Access Token using our Refresh Token.
const AuthResponse = getContentsOfURL("https://accounts.spotify.com/api/token", method: "POST", headers: {}, formBody: {
    "grant_type": "refresh_token",
    "refresh_token": @RefreshToken,
    "client_id": @ClientID,
    "client_secret": @ClientSecret
})
@AccessToken = AuthResponse['access_token']

// Check if we failed to get an access token.
if !AccessToken {
    ShowResult("Authentication with Spotify failed. Your Refresh Token may have expired.")
    stop()
}


// --- 4. Search for the Song on Spotify ---
// CORRECTED: URL-encode the song and artist names for the API query.
@EncodedSong = replaceText(" ", "%20", Song)
@EncodedArtist = replaceText(" ", "%20", Artist)

// CORRECTED: The URL must be a string, and variables are interpolated automatically.
const SearchURL = "https://api.spotify.com/v1/search?q=track:@{EncodedSong}+artist:@{EncodedArtist}&type=track&limit=1"
const SearchResponse = getContentsOfURL(SearchURL, headers: {
    "Authorization": "Bearer @{AccessToken}",
    "Content-Type": "application/json"
})

// Extract the track ID from the first search result.
@TrackID = SearchResponse['tracks']['items'][0]['id']


// --- 5. Add Song to Playlist ---
// If we couldn't find the track on Spotify, show an error and exit.
if !TrackID {
    // CORRECTED: String must be in quotes.
    show("Could not find '@{Song}' by '@{Artist}' on Spotify.")
    // CORRECTED: appendNote requires a body parameter and a string value.
    appendNote(body: "'@{Song}' by '@{Artist}' - Not Found", to: "Shazam Spotify Log")
    stop()
}

// Add the track to the specified playlist.
const AddTrackURL = "https://api.spotify.com/v1/playlists/@{PlaylistID}/tracks"
const AddTrackBody = { "uris": ["spotify:track:@{TrackID}"] }

// CORRECTED: There is no 'jsonRequest'. Use getContentsOfURL with a POST method and a JSON request body.
const AddResponse = getContentsOfURL(AddTrackURL, method: "POST", headers: {
    "Authorization": "Bearer @{AccessToken}",
    "Content-Type": "application/json"
}, jsonBody: AddTrackBody)

// --- 6. Show Final Result ---
// CORRECTED: Use an if/else block to show a clear success or failure message.
if AddResponse['error'] {
    const ErrorMessage = AddResponse['error']['message']
    show("Error: @{ErrorMessage}")
} else if AddResponse['snapshot_id'] {
    // A snapshot_id indicates a successful addition.
    show("'@{Song}' by '@{Artist}' has been added to your Spotify playlist!")
} else {
    show("An unknown error occurred while adding the song to the playlist.")
}
