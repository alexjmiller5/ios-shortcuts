#define name Now Playing → Spotify
#define color green
#define glyph musicNote
#include 'actions/web'

// Sends the song currently playing on Spotify through the same pipeline as
// Shazam → Spotify: look it up, dedup against the playlist, add it.
// Requires the user-read-currently-playing scope — reauthorize with Spotify
// Reauth (which now requests it) if this reports it can't read the player.

@ClientID = "<<secret:SPOTIFY_CLIENT_ID>>"
@ClientSecret = "<<secret:SPOTIFY_CLIENT_SECRET>>"
@RefreshToken = "<<secret:SPOTIFY_REFRESH_TOKEN>>"
@PlaylistID = "<<secret:SPOTIFY_SHAZAM_PLAYLIST_ID>>"

// 1. Get a new Access Token from Spotify using the Refresh Token.
@tokenResponse = formRequest("https://accounts.spotify.com/api/token", "POST", {
	"grant_type": "refresh_token",
	"refresh_token": "{RefreshToken}",
	"client_id": "{ClientID}",
	"client_secret": "{ClientSecret}"
})

@tokenResponseDict = getDictionary(@tokenResponse)
@AccessToken = getValue(@tokenResponseDict, "access_token")

if !@AccessToken {
	showNotification("Spotify refresh token expired. Run the Spotify Reauth shortcut, then paste the new token into this shortcut's RefreshToken field.", "Now Playing → Spotify")
	stop()
}

// 2. Ask the player what's on. A 204 empty body means nothing is playing; an
// error body means the token lacks the user-read-currently-playing scope.
@nowPlaying = downloadURL("https://api.spotify.com/v1/me/player/currently-playing", {
	"Authorization": "Bearer {AccessToken}"
})
@nowPlayingText = "{nowPlaying}"

if !@nowPlayingText {
	showNotification("Nothing is playing on Spotify right now.", "Now Playing → Spotify")
	stop()
}

@nowPlayingDict = getDictionary(@nowPlaying)
@item = getValue(@nowPlayingDict, "item")
@itemDict = getDictionary(@item)
@TrackID = getValue(@itemDict, "id")
@Song = getValue(@itemDict, "name")
@artists = getValue(@itemDict, "artists")
@firstArtist = getFirstItem(@artists)
@firstArtistDict = getDictionary(@firstArtist)
@Artist = getValue(@firstArtistDict, "name")

if !@TrackID {
	showNotification("Couldn't read the current track — nothing playing, or the token lacks the user-read-currently-playing scope (run Spotify Reauth to mint one that has it).", "Now Playing → Spotify")
	stop()
}

// 3. Skip the add if the track is already in the playlist. Pages through the
// playlist 100 tracks at a time following Spotify's `next` cursor.
// ponytail: capped at 20 pages (2000 tracks); bump the repeat count if the playlist outgrows it
@pageURL = "https://api.spotify.com/v1/playlists/{PlaylistID}/tracks?fields=next,items(track(id))&limit=100"
@morePages = "yes"
@alreadyInPlaylist = "no"
repeat page for 20 {
	if @morePages == "yes" && @alreadyInPlaylist == "no" {
		@pageResponse = downloadURL("{pageURL}", {
			"Authorization": "Bearer {AccessToken}"
		})
		@pageText = "{pageResponse}"
		if @pageText contains "{TrackID}" {
			@alreadyInPlaylist = "yes"
		}
		// `next` is a full URL for the next page, or JSON null (reads back empty) on the last one.
		@pageDict = getDictionary(@pageResponse)
		@nextPage = getValue(@pageDict, "next")
		@nextPageText = "{nextPage}"
		@morePages = "no"
		if @nextPageText contains "http" {
			@morePages = "yes"
			@pageURL = "{nextPage}"
		}
	}
}
if @alreadyInPlaylist == "yes" {
	showNotification("{Song} by {Artist} is already in the Spotify playlist.", "Now Playing → Spotify")
	stop()
}

// 4. Add the track to the playlist.
@addResponse = jsonRequest("https://api.spotify.com/v1/playlists/{PlaylistID}/tracks", "POST", {
	"uris": ["spotify:track:{TrackID}"]
}, {
	"Authorization": "Bearer {AccessToken}",
	"Content-Type": "application/json"
})

@addResponseDict = getDictionary(@addResponse)
@Error = getValue(@addResponseDict, "error")
if @Error {
	showNotification("{Song} by {Artist} could not be added to Spotify playlist.", "Now Playing → Spotify")
	stop()
}

showNotification("{Song} by {Artist} has been added to Spotify playlist.", "Now Playing → Spotify")
