#define name Shazam → Spotify
#define color blue
#define glyph shazam
#include 'actions/media'
#include 'actions/web'
#include 'actions/scripting'

const shazamResult = startShazam(false)

if !shazamResult {
	show("Unable to recognize the song.")
	stop()
}

const Song = getShazamDetail(shazamResult, "Title")
const Artist = getShazamDetail(shazamResult, "Artist")

@ClientID = "<<secret:SPOTIFY_CLIENT_ID>>"
@ClientSecret = "<<secret:SPOTIFY_CLIENT_SECRET>>"
@RefreshToken = "<<secret:SPOTIFY_REFRESH_TOKEN>>"
@PlaylistID = "<<secret:SPOTIFY_SHAZAM_PLAYLIST_ID>>"

// 1. Get a new Access Token from Spotify using the Refresh Token.
const tokenResponse = formRequest("https://accounts.spotify.com/api/token", "POST", {
	"grant_type": "refresh_token",
	"refresh_token": "{RefreshToken}",
	"client_id": "{ClientID}",
	"client_secret": "{ClientSecret}"
})

@AccessToken = getValue(tokenResponse, "access_token")

// Prepare song and artist for the URL by encoding spaces.
@encodedArtist = urlEncode(Artist)
@encodedSong = urlEncode(Song)

// 2. Search for the track on Spotify to get its ID.
const searchResult = downloadURL("https://api.spotify.com/v1/search?q=track:{encodedSong}+artist:{encodedArtist}&type=track&limit=1", {
	"Authorization": "Bearer {AccessToken}"
})

// Get the track ID from the first search result.
@trackItems = getValue(searchResult, "tracks.items")
@firstTrack = getFirstItem(trackItems)
@TrackID = getValue(firstTrack, "id")

// If no track ID was found, the song doesn't exist on Spotify.
if !TrackID {
    show("Could not find {Song} by {Artist} on Spotify.")
    
    jsonRequest("https://api.notion.com/v1/pages", "POST",
    {
        "parent": { "database_id": "39684873-3b4e-4059-82a4-045545e49324" },
        "properties": {
            "Name": {
                "title": [
                    {
                        "text": {
                            "content": "Add {Song} by {Artist} to Shazam Spotify playlist"
                        }
                    }
                ]
            },
            "Priority": {
                "select": {
                    "name": "Low"
                }
            },
            "Status": {
                "status": {
                    "name": "To Do"
                }
            },
            "Tags": {
                "multi_select": [
                    { "name": "Shortcuts" }
                ]
            }
        }
    },
    {
        "Authorization": "Bearer <<secret:SYNAPSE_NOTION_INTERNAL_INTEGRATION_SECRET>>",
        "Content-Type": "application/json",
        "Notion-Version": "2022-06-28"
    })
    stop()
}

// 3. Add the track to the playlist.
// This requires a POST request with a JSON body, so we use jsonRequest().
const addResponse = jsonRequest("https://api.spotify.com/v1/playlists/{PlaylistID}/tracks", "POST", {
	"uris": ["spotify:track:{TrackID}"]
}, {
	"Authorization": "Bearer {AccessToken}",
	"Content-Type": "application/json"
})

// Check the response for an error.
@Error = getValue(addResponse, "error")
if Error {
	show("{Song} by {Artist} could not be added to Spotify playlist.")
	stop()
}

show("{Song} by {Artist} has been added to Spotify playlist.")