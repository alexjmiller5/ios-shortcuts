#define name Shazam → Spotify
#define color blue
#define glyph shazam
#include 'actions/media'
#include 'actions/web'
#include 'actions/shortcuts'

@shazamResult = startShazam(false)

if !@shazamResult {
	show("Unable to recognize the song.")
	stop()
}

const Song = getShazamDetail(@shazamResult, "Title")
const Artist = getShazamDetail(@shazamResult, "Artist")

@ClientID = "<<secret:SPOTIFY_CLIENT_ID>>"
@ClientSecret = "<<secret:SPOTIFY_CLIENT_SECRET>>"
@RefreshToken = "<<secret:SPOTIFY_REFRESH_TOKEN>>"
@PlaylistID = "<<secret:SPOTIFY_SHAZAM_PLAYLIST_ID>>"

// 1. Get a new Access Token from Spotify using the Refresh Token.
@tokenResponse = formRequest("https://accounts.spotify.com/api/token", "POST", {
	"grant_type": "refresh_token",
	"refresh_token": "{RefreshToken}",
	"client_id": "{ClientID}",
	"client_secret": "{ClientSecret}"
})

@tokenResponseDict = getDictionary(@tokenResponse)
@AccessToken = getValue(@tokenResponseDict, "access_token")

// If the refresh token has expired, Spotify returns invalid_grant with no access
// token. Discard it (never retry), queue the song so it isn't lost, and tell the
// user to reauthorize. Spotify refresh tokens expire every 6 months (2026-07-20).
if !@AccessToken {
	@receptorInput = "Spotify token expired - couldn't add {Song} by {Artist} to the Shazam playlist. Run the Spotify Reauth shortcut, paste the new refresh token into Shazam → Spotify, then add this song manually $ low priority task"
	run("Receptor 📥", @receptorInput)
	show("Spotify refresh token expired. Run the Spotify Reauth shortcut, then paste the new token into this shortcut's RefreshToken field.")
	stop()
}

// Prepare song and artist for the URL by encoding spaces.
@encodedArtist = urlEncode(Artist)
@encodedSong = urlEncode(Song)

// 2. Search for the track on Spotify to get its ID.
@searchResult = downloadURL("https://api.spotify.com/v1/search?q=track:{encodedSong}+artist:{encodedArtist}&type=track&limit=1", {
	"Authorization": "Bearer {AccessToken}"
})

// Get the track ID from the first search result
@searchResultDict = getDictionary(@searchResult)
@tracks = getValue(@searchResultDict, "tracks")
@tracksDict = getDictionary(@tracks)
@trackItems = getValue(@tracksDict, "items")
@firstTrack = getFirstItem(@trackItems)
@firstTrackDict = getDictionary(@firstTrack)
@TrackID = getValue(@firstTrackDict, "id")

// If no track ID was found, the song doesn't exist on Spotify.
if !@TrackID {
    show("Could not find {Song} by {Artist} on Spotify.")
    @receptorInput = "The Spotify API couldn't recognize {Song} by {Artist} - Add it to the Shazam Spotify playlist manually $ low priority task"
    run("Receptor 📥", @receptorInput)
    stop()
}

// 3. Add the track to the playlist.
// This requires a POST request with a JSON body, so we use jsonRequest().
@addResponse = jsonRequest("https://api.spotify.com/v1/playlists/{PlaylistID}/tracks", "POST", {
	"uris": ["spotify:track:{TrackID}"]
}, {
	"Authorization": "Bearer {AccessToken}",
	"Content-Type": "application/json"
})

// Check the response for an error.
@addResponseDict = getDictionary(@addResponse)
@Error = getValue(@addResponseDict, "error")
if @Error {
	show("{Song} by {Artist} could not be added to Spotify playlist.")
	stop()
}

show("{Song} by {Artist} has been added to Spotify playlist.")
