#define name Remove Paywall
#define color blue
#define glyph compass
#define from sharesheet
#define inputs url, text
#include 'actions/web'
#include 'actions/text'

// Share a link to open it on removepaywall.com. Trims query params first
// (tracking junk confuses the search). Archive Page is the archive.ph sibling.

if ShortcutInput {
	@matches = matchText("^https?://[^/]+/[^?]+", "{ShortcutInput}")
	const url = getFirstItem(@matches)
	openURL("https://removepaywall.com/search?url={url}")
}
