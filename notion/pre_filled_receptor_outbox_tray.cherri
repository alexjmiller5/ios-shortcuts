#define name Pre-filled Receptor 📤
#define color violet
#define glyph brainHead
#define from sharesheet
#define inputs url, text

// Recept via Receptor app
action 'com.alexmiller.receptor.CaptureThoughtIntent' recept(text thought: 'text')

if ShortcutInput {
    const NameResult = getName(ShortcutInput)
    @InputName = "{NameResult}"
    if @InputName contains "https://maps.app.goo.gl" {
        @Thought = "{ShortcutInput} $ <insert-pre-filled-message>"
    } else {
        @Thought = ShortcutInput
    }
} else {
    nothing()
}

recept("{Thought}")
