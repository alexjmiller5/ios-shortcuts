#define name Add Video
#define color darkgray
#define glyph iPhone
#include 'actions/web'

@Title = prompt("Enter the short form video title")

const API_Response = jsonRequest("https://api.notion.com/v1/pages", "POST", {
    "parent": {
        "database_id": "<<secret:NOTION_VIDEO_DATABASE_ID>>"
    },
    "properties": {
        "Title": {
            "title": [
                {
                    "text": {
                        "content": "{Title}"
                    }
                }
            ]
        },
        "URL": {
            "url": "{Clipboard}"
        }
    },
    "icon": {
        "type": "emoji",
        "emoji": "📱"
    }
}, {
    "Authorization": "Bearer <<secret:ADD_VIDEO_NOTION_INTERNAL_INTEGRATION_SECRET>>",
    "Content-Type": "application/json",
    "Notion-Version": "2022-06-28"
})
