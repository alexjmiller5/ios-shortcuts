#define color darkgray
#define glyph feedRight

/*
A JavaScript one-liner to find out if your device has connectivity — @atnbueno (2020-09-30)

- This is less intrusive than other methods, like getting the IP address

v2.0.0 (2023-10-03) Now it works in Watch!
v2.1.0 (2024-03-29) Faster detection for the “offline” case
*/

const URLAsRichText = url("data:text/html,<body/><script>if(navigator.onLine){r=new XMLHttpRequest();r.open('GET','https://dummyjson.com/test',!1)};try{r.send(null);o='online'}catch(e){o='offline'}document.body.textContent=o</script>")
const JavaScriptOutput = urlDecode(URLAsRichText)
show(JavaScriptOutput)